{
  "manifest_version": 3,
  "name": "Afterimage",
  "version": "0.1.0",
  "description": "Tells the Afterimage app where passwords and account numbers are, so it never photographs them. Nothing leaves your Mac.",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "spanning",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "afterimage@jmaddington.com",
      "strict_min_version": "121.0"
    }
  }
}